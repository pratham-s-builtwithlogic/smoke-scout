<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Smoke Scout</title>
  
  <!-- Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
  
  <!-- Geospatial (Leaflet) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  
  <style>
    /* ---------- TOKENS (Midnight Green & Ivory) ---------- */
    :root {
      --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px; --s-5: 24px; --s-6: 32px; --s-7: 48px; --s-8: 64px; --s-9: 96px;
      --r-1: 4px; --r-2: 6px; --r-3: 10px; --r-4: 14px;
      --font-sans: "Geist", "Hanken Grotesk", ui-sans-serif, system-ui, -apple-system, sans-serif;
      --font-mono: "Geist Mono", "JetBrains Mono", ui-monospace, monospace;
      --ease: cubic-bezier(.2, 0, 0, 1); --t-fast: 140ms; --t-med: 240ms;
      color-scheme: dark;

      /* Midnight Green Palette */
      --bg: oklch(0.18 0.03 200); 
      --bg-sunken: oklch(0.15 0.03 200);
      --surface-1: oklch(0.22 0.03 200); 
      --surface-2: oklch(0.26 0.03 200); 
      --surface-3: oklch(0.30 0.03 200);

      --line: oklch(1 0 0 / 0.10); 
      --line-strong: oklch(1 0 0 / 0.18); 
      --highlight: oklch(1 0 0 / 0.08);

      --text: oklch(0.95 0.02 90); /* Ivory */
      --text-2: oklch(0.78 0.02 90); 
      --text-3: oklch(0.62 0.02 90);

      --accent: oklch(0.75 0.10 195); /* Air Teal */
      --accent-ink: oklch(0.20 0.03 195);
      --accent-soft: oklch(0.75 0.10 195 / 0.15);

      --ok: oklch(0.75 0.15 150); 
      --warn: oklch(0.80 0.16 70); 
      --err: oklch(0.65 0.18 25);

      --shadow-1: 0 0 0 1px var(--line), 0 1px 2px oklch(0 0 0 / .4);
      --shadow-2: 0 0 0 1px var(--line), 0 1px 1px oklch(0 0 0 / .3), 0 4px 8px -2px oklch(0 0 0 / .4), 0 12px 24px -8px oklch(0 0 0 / .5);
      --shadow-3: 0 0 0 1px var(--line-strong), inset 0 1px 0 var(--highlight), 0 1px 1px oklch(0 0 0 / .2), 0 4px 8px oklch(0 0 0 / .3), 0 16px 32px -8px oklch(0 0 0 / .6), 0 32px 64px -16px oklch(0 0 0 / .5);

      --edge-hi: oklch(1 0 0 / .20); --edge-mid: oklch(1 0 0 / .05); --edge-lo: oklch(1 0 0 / .02); --edge-end: oklch(1 0 0 / .09);
      --sunken-inset: inset 0 1px 2px oklch(0 0 0 / .3);
    }

    /* ---------- BASE STYLES ---------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; }
    html { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
    body { background: var(--bg); color: var(--text); font: 400 15px/1.6 var(--font-sans); min-height: 100vh; display: flex; flex-direction: column; }
    h1, h2, h3 { text-wrap: balance; font-weight: 500; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; border: 0; background: none; cursor: pointer; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-2); }
    ::selection { background: var(--accent-soft); }
    .mono { font-family: var(--font-mono); }
    .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
    .micro { font: 500 11px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
    .wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 var(--s-5); }
    main { flex: 1; }

    /* ---------- TEXTURE & GLASS ---------- */
    .grid-bg { position: fixed; inset: 0 0 auto 0; height: 100vh; z-index: -1; pointer-events: none;
      background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 48px 48px;
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 20%, transparent 75%);
              mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 20%, transparent 75%); }
    body::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 100; opacity: .025; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
    .glass { background: color-mix(in oklab, var(--surface-1) 62%, transparent); -webkit-backdrop-filter: blur(18px) saturate(150%); backdrop-filter: blur(18px) saturate(150%); box-shadow: var(--shadow-3); }

    /* ---------- COMPONENTS ---------- */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 36px; padding: 0 16px; border-radius: var(--r-2);
      font: 500 13.5px/1 var(--font-sans); letter-spacing: -.005em; transition: background var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease), transform 90ms var(--ease); user-select: none; }
    .btn:active { transform: translateY(1px) scale(.985); }
    .btn[disabled] { opacity: .45; pointer-events: none; }
    .btn-primary { background: var(--text); color: var(--bg); box-shadow: 0 0 0 1px oklch(0 0 0 / .2), inset 0 1px 0 oklch(1 0 0 / .35), 0 1px 2px oklch(0 0 0 / .3); }
    .btn-primary:hover { background: color-mix(in oklab, var(--text) 88%, var(--bg)); }
    .btn-secondary { background: var(--surface-2); box-shadow: var(--shadow-1), inset 0 1px 0 var(--highlight); }
    .btn-secondary:hover { background: var(--surface-3); }
    .btn-ghost { color: var(--text-2); } .btn-ghost:hover { background: var(--surface-2); color: var(--text); }
    
    .input { height: 36px; width: 100%; padding: 0 12px; background: var(--bg-sunken); color: var(--text); border-radius: var(--r-2); border: none; font: 400 14px var(--font-sans); box-shadow: inset 0 1px 2px oklch(0 0 0 / .25), 0 0 0 1px var(--line); transition: box-shadow var(--t-fast) var(--ease); }
    .input:focus-visible { outline: none; box-shadow: inset 0 1px 2px oklch(0 0 0 / .25), 0 0 0 1px var(--accent), 0 0 0 4px var(--accent-soft); }
    
    .card { background: var(--surface-1); border-radius: var(--r-3); box-shadow: var(--shadow-1), inset 0 1px 0 var(--highlight); overflow: hidden; }
    .card.interactive { transition: box-shadow var(--t-med) var(--ease), transform var(--t-med) var(--ease); cursor: pointer; }
    .card.interactive:hover { box-shadow: var(--shadow-2), inset 0 1px 0 var(--highlight); transform: translateY(-2px); }
    .panel-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--line); }
    
    .chip { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: var(--r-1); font: 500 11px var(--font-mono); letter-spacing: .04em; color: var(--text-2); background: var(--surface-2); box-shadow: 0 0 0 1px var(--line); }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); flex: none; }
    .dot.warn { background: var(--warn); } .dot.err { background: var(--err); } .dot.idle { background: var(--text-3); }
    .dot.live { animation: pulse 2s var(--ease) infinite; }
    @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--ok) 35%, transparent); } 50% { box-shadow: 0 0 0 5px transparent; } }
    
    .icon { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex: none; }

    /* ---------- NAVIGATION ---------- */
    .nav { position: sticky; top: 12px; z-index: 20; margin: 12px auto 0; max-width: 1200px; display: flex; align-items: center; justify-content: space-between; height: 52px; padding: 0 16px; border-radius: var(--r-3); }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -.02em; font-size: 16px; }
    .nav-links { display: flex; gap: 4px; }

    /* ---------- LAYOUTS ---------- */
    .hero { display: grid; grid-template-columns: 1fr; gap: var(--s-6); padding: var(--s-8) 0 var(--s-6); max-width: 800px; }
    .hero h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1.1; letter-spacing: -.03em; margin-bottom: var(--s-3); }
    .hero p { color: var(--text-2); font-size: 16px; max-width: 60ch; }
    
    .bento-split { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--s-4); margin-bottom: var(--s-8); }
    .feature-card { padding: var(--s-5); display: flex; flex-direction: column; gap: var(--s-3); height: 100%; }
    
    .workspace { display: grid; grid-template-columns: 1fr 320px; gap: var(--s-4); height: calc(100vh - 120px); min-height: 600px; padding-bottom: var(--s-5); }
    .workspace-main { display: flex; flex-direction: column; gap: var(--s-4); height: 100%; }
    #map-container { flex: 1; border-radius: var(--r-3); box-shadow: inset 0 1px 0 var(--highlight), 0 0 0 1px var(--line); z-index: 10; background: var(--bg-sunken); overflow: hidden; }
    
    /* Map overrides for tech theme */
    .leaflet-popup-content-wrapper { background: var(--surface-1); color: var(--text); border-radius: var(--r-2); border: 1px solid var(--line); box-shadow: var(--shadow-2); }
    .leaflet-popup-tip { background: var(--surface-1); border: 1px solid var(--line); border-top: none; border-left: none; }
    .leaflet-container a.leaflet-popup-close-button { color: var(--text-3); }
    
    /* Setup Forms */
    .setup-box { max-width: 480px; margin: var(--s-7) auto; padding: var(--s-5); }
    .form-group { margin-bottom: var(--s-4); }
    .form-group label { display: block; margin-bottom: var(--s-2); font: 500 12px var(--font-mono); color: var(--text-2); text-transform: uppercase; letter-spacing: 0.05em; }
    
    /* Metric Blocks */
    .metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin-top: var(--s-4); }
    .metric { padding: 16px; background: var(--bg-sunken); border-radius: var(--r-2); box-shadow: inset 0 1px 2px oklch(0 0 0 / .2); border: 1px solid var(--line); }
    .metric .val { font: 500 28px/1 var(--font-mono); letter-spacing: -.02em; margin: 8px 0 4px; display: block; }
    .status-banner { padding: 16px; border-radius: var(--r-2); margin-bottom: var(--s-4); border: 1px solid var(--line); display: flex; gap: 12px; align-items: flex-start; }
    .status-banner.err { background: color-mix(in oklab, var(--err) 10%, transparent); border-color: color-mix(in oklab, var(--err) 30%, transparent); }
    .status-banner.warn { background: color-mix(in oklab, var(--warn) 10%, transparent); border-color: color-mix(in oklab, var(--warn) 30%, transparent); }
    .status-banner.ok { background: color-mix(in oklab, var(--ok) 10%, transparent); border-color: color-mix(in oklab, var(--ok) 30%, transparent); }

    /* Timeline */
    .timeline { display: flex; flex-direction: column; gap: 12px; border-left: 2px solid var(--line); padding-left: 16px; margin: var(--s-4) 0; }
    .timeline-item { position: relative; }
    .timeline-item::before { content: ""; position: absolute; left: -21px; top: 6px; width: 8px; height: 8px; border-radius: 50%; background: var(--surface-3); border: 2px solid var(--bg); }
    .timeline-item.active::before { background: var(--accent); }

    /* Utilities */
    .loading-pulse { animation: loading 1.5s infinite var(--ease); }
    @keyframes loading { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    
    @media (max-width: 900px) {
      .workspace { grid-template-columns: 1fr; height: auto; }
      #map-container { height: 400px; flex: none; }
    }
  </style>
</head>
<body>
  <div class="grid-bg" aria-hidden="true"></div>

  <!-- Global Nav -->
  <header class="wrap">
    <nav class="nav glass" aria-label="Primary">
      <a class="brand" href="#" onclick="navigate('home')">
        <svg class="icon" viewBox="0 0 24 24"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
        Smoke Scout
      </a>
      <div class="nav-links">
        <button class="btn btn-ghost" onclick="navigate('resident')">Ventilation</button>
        <button class="btn btn-ghost" onclick="navigate('investigate')">Trace Smoke</button>
      </div>
    </nav>
  </header>

  <!-- Application Root -->
  <main class="wrap" id="app-root"></main>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // ---------- 1. STATE & CONFIG ---------- //
    const CONFIG = {
      // Paste your deployed AWS API Gateway endpoint here. 
      // If empty, the app honestly falls back to simulated demo behaviour.
      API_ENDPOINT: "", 
    };

    const state = {
      view: 'home',
      location: { lat: 30.9010, lon: 75.8573 }, // Default: Ludhiana, Punjab
      residentData: null,
      investigateData: null,
      isFetching: false,
      error: null
    };

    let mapInstance = null;
    let mapLayer = null;

    // ---------- 2. MOCK BACKEND SERVICE ---------- //
    // Replicates backend_start_2.py logic for judging / testing when disconnected.
    async function fetchSmokeData(mode) {
      state.isFetching = true;
      state.error = null;
      render();

      try {
        if (CONFIG.API_ENDPOINT) {
          const res = await fetch(CONFIG.API_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode, lat: state.location.lat, lon: state.location.lon, lookback_hours: 2.5 })
          });
          if (!res.ok) throw new Error('Environmental data service unavailable.');
          const data = await res.json();
          if (mode === 'citizen') state.residentData = data;
          else state.investigateData = data;
        } else {
          // --- HONEST DEMO MODE ---
          await new Promise(r => setTimeout(r, 1200)); // Simulate latency
          
          if (mode === 'citizen') {
            state.residentData = {
              mode: "citizen",
              location: state.location,
              advisory: {
                right_now: { status: "VERY_POOR", pm25_level: 162.4, action: "Keep windows closed. Avoid outdoor cardio." },
                tomorrow_planner: { morning_forecast_pm25: 185, morning_walk_advice: "AVOID morning ventilation. Heavy smoke inversion forecasted (185 µg/m³).", better_alternative: "Shift to midday (Forecast drops to 82 µg/m³)." }
              }
            };
          } else {
            const lat = state.location.lat;
            const lon = state.location.lon;
            const left_pt = [lon - 0.25, lat - 0.2];
            const right_pt = [lon + 0.15, lat - 0.3];
            
            state.investigateData = {
              mode: "fire_trace",
              status: "UNVERIFIED_SMOKE_PLUME",
              confidence_score: 3,
              location: { lat, lon },
              satellite_fires: [
                { lat: lat - 0.22, lon: lon - 0.05, frp_mw: 54.2, acq_time: "14:10 (SIMULATED)" }
              ],
              geojson: {
                type: "FeatureCollection",
                features: [
                  { type: "Feature", geometry: { type: "Point", coordinates: [lon, lat] }, properties: { layer: "sensor", pm25: 162.4 } },
                  { type: "Feature", geometry: { type: "Polygon", coordinates: [[[lon, lat], left_pt, right_pt, [lon, lat]]] }, properties: { layer: "search_wedge" } },
                  { type: "Feature", geometry: { type: "Point", coordinates: [lon - 0.05, lat - 0.22] }, properties: { layer: "nasa_fire_hotspot", frp: 54.2 } }
                ]
              }
            };
          }
        }
      } catch (err) {
        state.error = err.message;
      } finally {
        state.isFetching = false;
        render();
      }
    }

    // ---------- 3. ROUTING & RENDERING ---------- //
    function navigate(view) {
      state.view = view;
      state.error = null;
      if (view === 'home') {
        state.residentData = null;
        state.investigateData = null;
      }
      render();
    }

    function updateLocation(e) {
      e.preventDefault();
      const lat = parseFloat(document.getElementById('lat').value);
      const lon = parseFloat(document.getElementById('lon').value);
      if (!isNaN(lat) && !isNaN(lon)) {
        state.location = { lat, lon };
        fetchSmokeData(state.view === 'resident' ? 'citizen' : 'fire_trace');
      }
    }

    function render() {
      const root = document.getElementById('app-root');
      
      if (state.view === 'home') {
        cleanupMap();
        root.innerHTML = renderHome();
      } else if (state.view === 'resident') {
        cleanupMap();
        root.innerHTML = state.residentData ? renderResidentDashboard() : renderSetup('citizen');
      } else if (state.view === 'investigate') {
        root.innerHTML = state.investigateData ? renderInvestigateWorkspace() : renderSetup('fire_trace');
        if (state.investigateData) initMap();
      }
    }

    // ---------- 4. VIEWS ---------- //
    function renderHome() {
      return `
        <section class="hero">
          <h1>Know when to let the outside air in.<br><em>Discover where the smoke may begin.</em></h1>
          <p>Smoke Scout helps you find comparatively better times to ventilate your home and investigate possible stubble-burning sources using air-quality, wind, and satellite data.</p>
        </section>
        
        <section class="bento-split">
          <article class="card interactive feature-card" onclick="navigate('resident')" tabindex="0" role="button" aria-label="Go to ventilation timing tool">
            <div>
              <span class="micro">For Residents</span>
              <h2 style="margin: 12px 0; font-size: 24px;">When Can I Open My Windows?</h2>
              <p style="color: var(--text-2)">Find comparatively cleaner hours to ventilate your home based on current local sensor readings and inversion forecasts.</p>
            </div>
            <div style="margin-top: auto; padding-top: var(--s-4);">
              <button class="btn btn-primary">Check My Air</button>
            </div>
          </article>
          
          <article class="card interactive feature-card" onclick="navigate('investigate')" tabindex="0" role="button" aria-label="Go to smoke tracing tool">
            <div>
              <span class="micro">For Investigators</span>
              <h2 style="margin: 12px 0; font-size: 24px;">Trace the Smoke</h2>
              <p style="color: var(--text-2)">Explore wind patterns and NASA FIRMS satellite detections to investigate the geographical origin of severe pollution spikes.</p>
            </div>
            <div style="margin-top: auto; padding-top: var(--s-4);">
              <button class="btn btn-secondary">Start an Investigation</button>
            </div>
          </article>
        </section>
        <div style="font-size: 13px; color: var(--text-3); text-align: center;">Data sourced from Open-Meteo AQ API and NASA FIRMS. ${!CONFIG.API_ENDPOINT ? '<br><strong>Notice:</strong> Running in local demo mode. No live server connected.' : ''}</div>
      `;
    }

    function renderSetup(mode) {
      const title = mode === 'citizen' ? "Ventilation Assessment Setup" : "Trace Investigation Setup";
      const btnText = mode === 'citizen' ? "Evaluate Air Quality" : "Begin Trace";
      
      let loadingHTML = state.isFetching ? `<div class="loading-pulse" style="margin-top: 16px; font-family: var(--font-mono); color: var(--text-2); font-size: 12px;">Retrieving environmental payload...</div>` : '';
      let errHTML = state.error ? `<div style="margin-top: 16px; color: var(--err); font-family: var(--font-mono); font-size: 12px;">Error: ${state.error}</div>` : '';

      return `
        <div class="card setup-box">
          <div class="panel-head">
            <span class="micro">${title}</span>
          </div>
          <div style="padding: var(--s-4);">
            <p style="margin-bottom: var(--s-4); color: var(--text-2); font-size: 14px;">
              Enter coordinates to retrieve local sensor and forecast data.
            </p>
            <form onsubmit="updateLocation(event)">
              <div class="form-group">
                <label for="lat">Latitude (Punjab)</label>
                <input type="number" id="lat" class="input num" step="0.0001" value="${state.location.lat}" required>
              </div>
              <div class="form-group">
                <label for="lon">Longitude (Punjab)</label>
                <input type="number" id="lon" class="input num" step="0.0001" value="${state.location.lon}" required>
              </div>
              <button type="submit" class="btn btn-primary" style="width: 100%" ${state.isFetching ? 'disabled' : ''}>
                ${btnText}
              </button>
            </form>
            ${loadingHTML}
            ${errHTML}
          </div>
        </div>
      `;
    }

    function renderResidentDashboard() {
      const adv = state.residentData.advisory;
      const rn = adv.right_now;
      const tp = adv.tomorrow_planner;
      
      let bannerClass = rn.status === 'GOOD' ? 'ok' : (rn.status === 'SEVERE_EMERGENCY' || rn.status === 'VERY_POOR' ? 'err' : 'warn');
      let icon = bannerClass === 'err' ? 'X' : (bannerClass === 'ok' ? '✓' : '!');
      
      return `
        <div style="max-width: 640px; margin: var(--s-5) auto;">
          <h1 style="font-size: 32px; margin-bottom: var(--s-5);">Should I open my windows right now?</h1>
          
          <div class="status-banner ${bannerClass}">
            <div style="margin-top: 2px; font-weight: bold; font-family: var(--font-mono);">${icon}</div>
            <div>
              <h3 style="margin-bottom: 4px; font-size: 18px;">${rn.action}</h3>
              <div style="color: var(--text-2); font-size: 14px;">Current Status: <span class="num">${rn.status.replace('_', ' ')}</span></div>
            </div>
          </div>

          <div class="metric-grid" style="margin-bottom: var(--s-5);">
            <div class="metric">
              <span class="micro">Current PM2.5</span>
              <span class="val">${rn.pm25_level} <span style="font-size: 14px; color: var(--text-3)">µg/m³</span></span>
            </div>
            <div class="metric">
              <span class="micro">Location Confirmed</span>
              <span class="val" style="font-size: 18px; margin-top: 14px;">${state.location.lat.toFixed(4)}, ${state.location.lon.toFixed(4)}</span>
            </div>
          </div>

          <div class="card" style="padding: var(--s-4);">
            <h3 style="margin-bottom: var(--s-2);">Ventilation Timing Comparison</h3>
            <p style="color: var(--text-2); font-size: 14px;">Based on available inversion forecast data.</p>
            
            <div class="timeline">
              <div class="timeline-item ${tp.morning_forecast_pm25 < rn.pm25_level ? 'active' : ''}">
                <div style="font-weight: 500;">Morning Window (06:00)</div>
                <div style="color: var(--text-2); font-size: 14px; margin-top: 4px;">${tp.morning_walk_advice}</div>
              </div>
              <div class="timeline-item ${tp.morning_forecast_pm25 >= rn.pm25_level ? 'active' : ''}">
                <div style="font-weight: 500;">Midday Window (14:00)</div>
                <div style="color: var(--text-2); font-size: 14px; margin-top: 4px;">${tp.better_alternative}</div>
              </div>
            </div>
          </div>
          
          <button class="btn btn-ghost" style="margin-top: var(--s-4);" onclick="navigate('home')">← Start Over</button>
        </div>
      `;
    }

    function renderInvestigateWorkspace() {
      const data = state.investigateData;
      let statusDot = data.status === 'NORMAL_AIR' ? 'idle' : (data.status === 'CONFIRMED_STUBBLE_FIRE' ? 'err live' : 'warn');
      let firesCount = data.satellite_fires ? data.satellite_fires.length : 0;

      return `
        <div class="workspace">
          <div class="workspace-main">
            <div class="panel-head" style="border: 1px solid var(--line); border-radius: var(--r-3); background: var(--surface-1);">
              <div>
                <span class="micro" style="margin-right: 12px;">Trace Status</span>
                <span class="chip"><span class="dot ${statusDot}"></span>${data.status.replace(/_/g, ' ')}</span>
              </div>
              <div class="num" style="font-size: 13px; color: var(--text-3);">${state.location.lat.toFixed(4)}, ${state.location.lon.toFixed(4)}</div>
            </div>
            
            <div id="map-container"></div>
          </div>
          
          <aside style="display: flex; flex-direction: column; gap: var(--s-4);">
            <div class="card">
              <div class="panel-head"><span class="micro">Evidence Discovered</span></div>
              <div style="padding: 16px;">
                <div style="margin-bottom: 12px; font-size: 14px;">
                  <span style="color: var(--text-3);">Hotspots in Corridor:</span> 
                  <b class="num" style="float: right;">${firesCount}</b>
                </div>
                ${firesCount > 0 ? data.satellite_fires.map(f => `
                  <div style="background: var(--bg-sunken); padding: 8px 12px; border-radius: var(--r-2); border: 1px solid var(--line); margin-bottom: 8px;">
                    <div class="num" style="font-size: 12px; color: var(--text-2);">${f.lat.toFixed(3)},${f.lon.toFixed(3)}</div>
                    <div style="font-size: 13px; margin-top: 4px;">Radiative Power: <span class="num">${f.frp_mw} MW</span></div>
                  </div>
                `).join('') : '<div style="color: var(--text-3); font-size: 13px;">No NASA FIRMS records matched upwind geometry.</div>'}
              </div>
            </div>

            <div class="card">
              <div class="panel-head"><span class="micro">Methodology</span></div>
              <div style="padding: 16px; font-size: 13px; color: var(--text-2); line-height: 1.5;">
                <p style="margin-bottom: 8px;">1. Detects local PM2.5 baseline.</p>
                <p style="margin-bottom: 8px;">2. Projects a 2.5-hour upwind search corridor based on kinematic drift.</p>
                <p style="margin-bottom: 8px;">3. Intersects geometry with active NASA satellite thermal anomalies.</p>
                <p style="color: var(--warn); margin-top: 12px;"><em>Note: Wind-based geometry is an estimate and does not establish definitive causation.</em></p>
              </div>
            </div>
            
            <button class="btn btn-secondary" onclick="navigate('home')" style="margin-top: auto;">Close Investigation</button>
          </aside>
        </div>
      `;
    }

    function initMap() {
      const data = state.investigateData;
      if (!data || !data.geojson) return;

      if (!mapInstance) {
        mapInstance = L.map('map-container', { zoomControl: false }).setView([state.location.lat, state.location.lon], 10);
        L.control.zoom({ position: 'bottomright' }).addTo(mapInstance);
        
        // CartoDB Dark Matter for severe tech aesthetic
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          subdomains: 'abcd',
          maxZoom: 20
        }).addTo(mapInstance);
      }

      if (mapLayer) mapInstance.removeLayer(mapLayer);

      mapLayer = L.geoJSON(data.geojson, {
        pointToLayer: function (feature, latlng) {
          if (feature.properties.layer === 'nasa_fire_hotspot') {
            return L.circleMarker(latlng, { radius: 6, fillColor: 'var(--err)', color: 'var(--bg)', weight: 2, fillOpacity: 0.9 });
          }
          return L.circleMarker(latlng, { radius: 7, fillColor: 'var(--text)', color: 'var(--bg)', weight: 2, fillOpacity: 1 });
        },
        style: function (feature) {
          if (feature.geometry.type === 'Polygon') {
            return { color: 'var(--warn)', weight: 1, fillColor: 'var(--warn)', fillOpacity: 0.1, dashArray: '4' };
          }
        },
        onEachFeature: function(feature, layer) {
           let content = `<div style="font-family: var(--font-sans); font-size: 13px;">`;
           if (feature.properties.layer === 'nasa_fire_hotspot') {
             content += `<strong style="color: var(--err); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em;">Satellite Hotspot</strong><br><span class="num">FRP: ${feature.properties.frp} MW</span>`;
           } else if (feature.properties.layer === 'sensor') {
             content += `<strong style="color: var(--text-2); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em;">Monitor Location</strong><br><span class="num">PM2.5: ${feature.properties.pm25} µg/m³</span>`;
           } else {
             content += `<strong style="color: var(--warn); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em;">Kinematic Corridor</strong><br>Estimated upwind trajectory`;
           }
           content += `</div>`;
           layer.bindPopup(content, { closeButton: false, offset: [0, -5] });
        }
      }).addTo(mapInstance);

      // Fit map to show both the sensor and the end of the wedge
      mapInstance.fitBounds(mapLayer.getBounds(), { padding: [50, 50], maxZoom: 12 });
    }

    function cleanupMap() {
      if (mapInstance) {
        mapInstance.remove();
        mapInstance = null;
        mapLayer = null;
      }
    }

    // Initialize
    window.addEventListener('DOMContentLoaded', () => navigate('home'));
  </script>
</body>
</html>
