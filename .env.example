FOR BACKEND :

# AWS DynamoDB Incident Audit Table
DYNAMODB_TABLE="Your DynamoDB Table Name"

# NASA FIRMS 32-character API Map Key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_MAP_KEY="your_32_character_nasa_firms_map_key"

# S3 Bucket hosting GeoJSON map layers
S3_BUCKET="your s3 bucket name"

# S3 Object key (filename) 
S3_KEY="filename for the geojson file"






FOR FRONTEND :

# Full invoke URL of your API Gateway endpoint, including stage and resource path.
# The app POSTs JSON to exactly this URL.
# Example: https://abc123.execute-api.ap-south-1.amazonaws.com/prod/trace
#
# If this is empty, the app runs in clearly labelled DEMO mode with simulated data.
VITE_API_URL=

# Set to "true" to force demo mode even when VITE_API_URL is set.
VITE_DEMO_MODE=false

# Content-Type sent to the API. The default (text/plain) is a CORS "simple request",
# so the browser skips the OPTIONS preflight. Lambda still receives the JSON text in
# event.body. Use application/json only if your API has OPTIONS/CORS fully configured
# or your integration needs it.
VITE_API_CONTENT_TYPE=text/plain;charset=UTF-8

# Optional: override the basemap tiles (must be a {z}/{x}/{y} template) for both journeys.
VITE_TILE_URL=

